# No secrets live in this repo. Copy to .env and fill locally.
# TrueForge runs at http://localhost:8790 and stores its own model, sandbox and
# search keys in its local database - none of them belong here.
TRUEFORGE_BASE_URL=http://localhost:8790

# Local MCP servers. These are the defaults the servers and the registration
# script already use; override only if the ports are taken.
JOBS_MCP_PORT=8793
APPLY_MCP_PORT=8794

# The egress guard blocks all outbound hosts except those listed here. The demo
# employer runs on 8795, so without this an approved application cannot be
# delivered. Required by both MCP servers.
DOSSIER_ALLOW_ORIGINS=http://127.0.0.1:8795
